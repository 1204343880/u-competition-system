MYSQL_PASSWORD=change-this-mysql-password
REDIS_PASSWORD=change-this-redis-password
MQ_PASSWORD=change-this-rabbitmq-password
AGENT_SHARED_SECRET=change-this-agent-shared-secret
MEMORY_ENCRYPTION_KEY=replace-with-fernet-key
DEEPSEEK_API_KEY=replace-with-deepseek-key
ZHIPU_API_KEY=replace-with-zhipu-key
AGENT_IMAGE=ghcr.io/your-github-owner/innotrack-agent:latest
AGENT_BUILD_VERSION=prod
AGENT_BUILD_COMMIT=unknown
OFFICIAL_EVIDENCE_API_URL=
OFFICIAL_EVIDENCE_API_KEY=
OFFICIAL_EVIDENCE_ALLOWED_DOMAINS=
OFFICIAL_EVIDENCE_TIMEOUT_SECONDS=5
JAVA_OPTS=-Xms256m -Xmx512m -XX:MetaspaceSize=128m -XX:MaxMetaspaceSize=256m
